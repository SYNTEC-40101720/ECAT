{
  "name": "ecat-test-electron",
  "version": "1.0.0",
  "private": true,
  "description": "Electron HMI for the ECAT Test WebSocket backend",
  "author": {
    "name": "SYNTEC"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test tests/backend_lifecycle.test.cjs",
